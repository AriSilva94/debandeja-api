# Referência para as variáveis do app backend no Dokploy (prd). Valores reais
# ficam só no painel do Dokploy; NUNCA preencher este arquivo: ele vai para o GitHub.

# URLs internas mostradas nos serviços PostgreSQL e Redis do Dokploy.
DATABASE_URL="postgresql://<usuario>:<senha>@<host-interno-postgres>:5432/<banco>?schema=public"
REDIS_URL="redis://:<senha>@<host-interno-redis>:6379"

# Aleatório e longo, exclusivo deste ambiente. Trocar invalida todas as sessões.
JWT_SECRET="<gerar>"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

PORT=3000

# Domínio público do frontend: CORS e links dos e-mails. Sem barra no final.
APP_URL="https://debandeja.store"

# E-mail da Hostinger (caixa auth@debandeja.store). A senha é a da caixa,
# definida no hPanel; fica só no Dokploy. O remetente precisa ser a própria caixa.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="auth@debandeja.store"
SMTP_PASS="<senha-da-caixa>"
MAIL_FROM="Debandeja <auth@debandeja.store>"

INVITE_TOKEN_TTL_HOURS=48
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_HOURS=2

# Mesmo valor no frontend deste ambiente, mínimo 32 caracteres.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_TOKEN="<gerar>"
